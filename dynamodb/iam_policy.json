{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadJobRequirements",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/smarthire_job_requirements"
    },
    {
      "Sid": "WriteEvaluations",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/smarthire_evaluations"
    },
    {
      "Sid": "ZapierTableDropdown",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListTables"
      ],
      "Resource": "*"
    }
  ]
}
